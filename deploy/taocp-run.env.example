# Copy to ~/.config/taocp/run.env on the run host and edit. systemd does not
# expand ~ or $HOME in an environment file, so write the paths out in full.
#
# Nothing here is a secret. The route file names the endpoints and the
# environment variables their keys come from; the keys themselves belong in the
# host's own environment or in a file only the runner's user can read.

# The three directories a run reads and writes. Both repositories are cloned
# once and kept on main by hand: the runner does not clone or reset them,
# because a runner that repairs its own working copy is a runner that can throw
# away work.
TAOCP_SOLVER_SOURCE=/home/USER/github/tamnd/taocp
TAOCP_SOLVER_BRAIN=/home/USER/github/tamnd/brain
TAOCP_SOLVER_OUTPUT=/home/USER/data/taocp-solver

# The ranked endpoints to try, in order, with the cooldowns that failover uses.
# Write a starting point with:
#   taocp doctor --write-routes ~/.config/taocp/routes.json
TAOCP_ROUTES=/home/USER/.config/taocp/routes.json

# Two hosts can publish into the same content repository at once. Give each one
# a disjoint slice of the work so they are not solving the same exercises, by
# adding --section flags to ExecStart in the unit.
